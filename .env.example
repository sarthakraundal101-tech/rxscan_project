# RxScan Environment Configuration Template
# Copy this file to .env and customize for your environment

DEBUG=True
SECRET_KEY=college-project-secure-random-key-change-in-production
ALLOWED_HOSTS=127.0.0.1,localhost

# Tesseract OCR Executable (leave blank if installed in standard PATH or C:\Program Files\Tesseract-OCR)
# On Linux/Docker: /usr/bin/tesseract
# On Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Confidence Bands (%)
CONF_HIGH=90
CONF_REVIEW=70
MAX_UPLOAD_MB=8
